{
  "name": "agent-workspace-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "convex dev --start \"next dev\"",
    "dev:app": "next dev",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "seed": "convex run seed:seedTemplate",
    "art:generate": "node scripts/generate-pack-covers.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "verify:public": "node scripts/verify-public.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:public"
  },
  "dependencies": {
    "convex": "^1.17.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.11",
    "tsx": "4.23.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  }
}
